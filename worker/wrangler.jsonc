{
  "name": "belcarra-contact-mailer",
  "main": "contact.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_IP_LIMITER", "namespace_id": "2501001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_SITE_LIMITER", "namespace_id": "2501002", "simple": { "limit": 60, "period": 60 } }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["info@belcarra.com", "security@belcarra.com"]
    }
  ]
}
